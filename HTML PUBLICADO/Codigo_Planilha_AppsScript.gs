function atualizarTodosOsPostes() {
  const shPostes = getSheet_(ABA_POSTES, CABECALHO_POSTES);
  const feitos = {};
  const dadosPostes = shPostes.getDataRange().getValues();
  for (let i = 1; i < dadosPostes.length; i++) {
    const codId = String(dadosPostes[i][0]);
    feitos[codId] = { nome: dadosPostes[i][3], cor: dadosPostes[i][4], data_hora: dadosPostes[i][5] };
  }

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let sh = ss.getSheetByName(ABA_TODOS_POSTES);
  if (!sh) {
    sh = ss.insertSheet(ABA_TODOS_POSTES);
  } else {
    sh.clear();
  }
  sh.appendRow(CABECALHO_TODOS_POSTES);

  const linhas = TODOS_POSTES_REF.map(function (ref) {
    const codId = ref[0];
    const f = feitos[codId];
    return [codId, ref[1], ref[2], f ? f.nome : '', f ? f.cor : '', f ? f.data_hora : ''];
  });
  if (linhas.length) {
    sh.getRange(2, 1, linhas.length, CABECALHO_TODOS_POSTES.length).setValues(linhas);
  }
  Logger.log('Todos os Postes atualizado: ' + linhas.length + ' linhas, ' + Object.keys(feitos).length + ' ja feitos.');
}

function configurarAtualizacaoAutomatica() {
  ScriptApp.getProjectTriggers().forEach(function (t) {
    if (t.getHandlerFunction() === 'atualizarTodosOsPostes') ScriptApp.deleteTrigger(t);
  });
  ScriptApp.newTrigger('atualizarTodosOsPostes').timeBased().everyMinutes(10).create();
  atualizarTodosOsPostes();
  Logger.log('Atualizacao automatica configurada: a cada 10 minutos.');
}
