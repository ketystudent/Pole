function semearRobo() {
  const sh = getSheet_(ABA_POSTES, CABECALHO_POSTES);
  const dados = sh.getDataRange().getValues();
  const existentes = new Set();
  for (let i = 1; i < dados.length; i++) {
    existentes.add(String(dados[i][0]) + '|' + String(dados[i][1]) + '|' + String(dados[i][2]));
  }
  const agora = new Date().toISOString();
  const novasLinhas = [];
  POSTES_ROBO.forEach(function (par) {
    const codId = par[0];
    const chave = codId + '|' + CIDADE_ROBO + '|' + RUN_ID_ROBO;
    if (!existentes.has(chave)) {
      novasLinhas.push([codId, CIDADE_ROBO, RUN_ID_ROBO, NOME_ROBO, COR_ROBO, agora]);
      existentes.add(chave);
    }
  });
  if (novasLinhas.length) {
    sh.getRange(sh.getLastRow() + 1, 1, novasLinhas.length, CABECALHO_POSTES.length).setValues(novasLinhas);
  }
  Logger.log('Inseridos agora: ' + novasLinhas.length + ' | ja existiam: ' + (POSTES_ROBO.length - novasLinhas.length));
}

/**
 * Corrige linhas da aba "Postes" que ficaram com o nome errado por causa
 * da fila antiga de testes que foi disparada antes de existir a protecao
 * de dono em upsertPoste_. Para cada linha com nome = nomeContaminado:
 *  - se o cod_id esta na lista POSTES_ROBO (ou seja, o Robo ja tinha
 *    fotografado esse poste e a linha foi indevidamente sobrescrita),
 *    restaura o dono para Robo em vez de so apagar -- assim nao perde o
 *    registro de que a foto ja existe;
 *  - senao, apaga a linha (nunca deveria ter existido).
 * Roda uma vez, na propria tela do Apps Script (Executar > selecionar
 * corrigirLinhasContaminadas).
 */
function corrigirLinhasContaminadas() {
  corrigirLinhasContaminadasPara_('Ketlyn');
}

function corrigirLinhasContaminadasPara_(nomeContaminado) {
  const sh = getSheet_(ABA_POSTES, CABECALHO_POSTES);
  const dados = sh.getDataRange().getValues();
  const robosPorCodId = new Set(POSTES_ROBO.map(function (par) { return par[0]; }));
  const agora = new Date().toISOString();
  let restauradas = 0;
  let apagadas = 0;
  for (let i = dados.length - 1; i >= 1; i--) {
    const linha = dados[i];
    if (String(linha[3]) !== nomeContaminado) continue;
    const codId = String(linha[0]);
    const cidade = String(linha[1]);
    const runId = String(linha[2]);
    // guarda no historico o nome original antes de mexer, pra nao perder o
    // registro de que "nomeContaminado" apareceu aqui, mesmo que a linha
    // em "Postes" mude de dono depois.
    registrarHistorico_(codId, cidade, runId, nomeContaminado, String(linha[4] || ''), String(linha[5] || ''), 'correcao_removida');
    if (cidade === CIDADE_ROBO && runId === RUN_ID_ROBO && robosPorCodId.has(codId)) {
      sh.getRange(i + 1, 4, 1, 3).setValues([[NOME_ROBO, COR_ROBO, agora]]);
      registrarHistorico_(codId, cidade, runId, NOME_ROBO, COR_ROBO, agora, 'correcao_restaurada_robo');
      restauradas++;
    } else {
      sh.deleteRow(i + 1);
      apagadas++;
    }
  }
  Logger.log('Restauradas para Robo: ' + restauradas + ' | Apagadas (nao eram do robo): ' + apagadas);
}


